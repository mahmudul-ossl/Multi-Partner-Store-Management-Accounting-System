# `docker compose up -d` does not need this file. Copy it to `.env` for a host
# install, or for `docker-compose.prod.yml`.
APP_NAME="MP Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
# Host port for `docker compose`. Ignored by PHP. Default 8000 when this file is absent.
APP_PORT=8000

# Comma-separated proxy IPs or CIDRs. Leave empty when the app is reached directly.
# Set to * only when every connection comes through a trusted proxy (Cloudflare Tunnel, for example).
TRUSTED_PROXIES=

# Comma-separated proxy IPs or CIDRs. Leave empty when the app is reached directly.
# Set to * only when every connection comes through a trusted proxy (Cloudflare Tunnel, for example).
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳
APP_DATE_FORMAT=d-M-Y

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mpstore
DB_USERNAME=mpstore
DB_PASSWORD=mpstore
DB_ROOT_PASSWORD=rootsecret
DB_FORWARD_PORT=3306

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@mpstore.test"
MAIL_FROM_NAME="${APP_NAME}"

# Demo seed only. Change these before any shared or production environment.
SEED_SUPER_ADMIN_NAME="System Administrator"
SEED_SUPER_ADMIN_EMAIL=superadmin@mpstore.test
SEED_SUPER_ADMIN_PASSWORD="SuperAdmin#2026"
SEED_DEMO_PASSWORD="Partner#2026"

PHPMYADMIN_PORT=8081

VITE_APP_NAME="${APP_NAME}"
